{
  "manifest_version": 2,
  "name": "Archive Console Cookies",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "version": "1.4.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "developer": {
    "name": "Archive Console",
    "url": "https://github.com/hrdl-github/cookies-txt"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "archive-cookies-bridge@yt-dlp-scripts.local",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "113.0"
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "browser_action": {
    "default_title": "__MSG_buttonDescription__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/choose_option.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "permissions": [
    "cookies",
    "downloads",
    "contextualIdentities",
    "alarms",
    "storage",
    "http://127.0.0.1/*",
    "<all_urls>",
    "tabs",
    "clipboardWrite"
  ]
}
